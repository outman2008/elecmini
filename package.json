{
  "name": "elecmini",
  "version": "1.2.0",
  "description": "Electron API contract with system WebView rendering (tao + wry + Node sidecar) — drop Chromium, keep require('electron').",
  "license": "MIT",
  "author": "ElecMini contributors",
  "homepage": "https://github.com/outman2008/elecmini#readme",
  "main": "runtime/electron.js",
  "bin": {
    "elecmini": "bin/elecmini.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outman2008/elecmini.git"
  },
  "bugs": {
    "url": "https://github.com/outman2008/elecmini/issues"
  },
  "keywords": [
    "electron",
    "webview",
    "tauri",
    "wry",
    "desktop",
    "chromium-free",
    "electron-alternative",
    "compatibility-layer"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "assets/",
    "README.md",
    "README.en.md",
    "llms.txt",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "Cargo.toml",
    "bin/",
    "examples/",
    "runtime/",
    "host/",
    "shim/src/",
    "pack/*.js",
    "pack/config.json",
    "pack/gray-config.json",
    "pack/templates/",
    "ci/check.sh",
    "ci/prettier-ratchet.js",
    "ci/prettier-baseline.json",
    "contract/*.js",
    "contract/probe-app/",
    "compat/baseline.json",
    "compat/check.js",
    "compat/feature-probe.js",
    "compat/probe.html",
    "migrate/assess.js",
    "migrate/gen-probe.js",
    "migrate/api-surface/audit.js",
    "migrate/api-surface/gen-contract.js",
    "migrate/api-surface/contract-fill.test.js",
    "migrate/api-surface/official-specs/",
    "migrate/README.md",
    "docs/unsupported-apis.md",
    "docs/incremental-update.md",
    "docs/resource-hot-update.md",
    "docs/updater-ui.md"
  ],
  "scripts": {
    "lint": "eslint runtime shim/src pack contract",
    "format:check": "prettier --check \"runtime/**/*.js\" \"shim/src/**/*.js\" \"pack/**/*.js\" \"contract/**/*.js\"",
    "format:ratchet": "node ci/prettier-ratchet.js",
    "format:baseline": "node ci/prettier-ratchet.js --update",
    "test": "bash ci/check.sh --quick",
    "test:full": "bash ci/check.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
