# ElecMini — Git 忽略规则
# 只提交源码、文档、配置与测试；构建产物/依赖不入库。

# Rust 构建产物
# 注意：Cargo.lock 需提交（本仓库是应用而非库，锁定依赖以保证可复现构建）
target/

# Node 依赖
node_modules/

# 打包产物与更新清单
dist/

# 兼容基线/契约/遥测运行时结果（结果文件忽略）
compat/results/*.json
contract/results/elecmini.json
contract/results/electron.json
contract/results/diff-report.json
pack/webview-versions.jsonl

# 验收/门禁运行时产物（可再生成，不入库）
gate-distribution-report.json
gray-report.json
api-call-sites.json
gate-paths.jsonl

# 官方 API 表面检测的运行时产物（由 audit.js 重新生成）
migrate/api-surface/results/

# 真实迁移示例：第三方源码与适配产物（按需拉取/生成，不入库）
migrate/full-app/electron-api-demos/
migrate/full-app/electron-api-demos-adapted/
migrate/probes/*/out.json

# 系统/编辑器
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# 日志与临时
*.log
*.tmp
/tmp/
